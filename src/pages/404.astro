---
import Base from '../layouts/Base.astro';
import Sticker from '../components/Sticker.astro';
// Cloudflare serve este 404.html para qualquer endereço inexistente, nas duas línguas.
// Conceito: rafe de layout reprovado. O "04" vem circulado à mão com a caneta de destaque;
// o pedido "dar mais destaque" é atendido no clique (peso e cor mudam).
---

<Base title="Página não encontrada, João Kavalchuk">
  <section class="erro">
    <Sticker nome="refacao" class="sticker-erro-1" style="--giro: 8deg" />
    <Sticker nome="arquivo" class="sticker-erro-2" style="--giro: -6deg" />
    <Sticker nome="quatro" class="sticker-erro-3" style="--giro: 10deg" />
    <div class="rafe">
      <button type="button" class="codigo" data-logo aria-pressed="false" aria-label="404. Clique para dar mais destaque">
        <span class="digitos" aria-hidden="true">4<span class="alvo">04<svg class="circulo" viewBox="0 0 100 60" preserveAspectRatio="none">
              <path pathLength="1" d="M58 6 C 30 2, 4 12, 5 31 C 6 50, 34 58, 60 55 C 86 52, 98 40, 95 24 C 92 9, 70 3, 44 8" />
            </svg></span></span>
      </button>
      <p class="nota nota-1" aria-hidden="true">reprovado pelo cliente</p>
      <p class="nota nota-2" data-pedido aria-live="polite">dar mais destaque</p>
    </div>

    <ul class="notas" aria-label="Anotações do rafe">
      <li><span>prazo:</span> ontem</li>
      <li><span>arquivo:</span> 404_v3_final_FINAL_agora-vai.psd</li>
      <li><span>feedback:</span> “gostei, mas não é isso”</li>
    </ul>

    <h1>Esta página não passou na aprovação.</h1>
    <p class="texto">O endereço que você procurou mudou ou nunca existiu. A boa notícia: o resto do site foi aprovado de primeira.</p>
    <p class="texto secundario" lang="en">Page not found. This layout got rejected, but the rest of the site is live.</p>

    <nav class="atalhos" aria-label="Atalhos">
      <a href="/">Home</a>
      <a href="/#trabalhos">Trabalhos</a>
      <a href="/sobre/">Sobre</a>
      <a href="/#contato">Contato</a>
      <a href="/en/" lang="en">English</a>
    </nav>

    <section class="jogo" aria-labelledby="jogo-titulo">
      <h2 id="jogo-titulo">Enquanto isso, fuja da refação</h2>
      <p class="secundario">Espaço, seta para cima ou toque para pular.</p>
      <div class="jogo-palco">
        <canvas data-jogo aria-label="Jogo: o cursor pula os pedidos de refação"></canvas>
        <p class="jogo-aviso" data-jogo-aviso>Toque ou aperte espaço para começar.</p>
      </div>
      <p class="jogo-placar" data-jogo-placar aria-live="polite"></p>
    </section>
  </section>
</Base>

<style>
  .erro {
    /* espaço em cima para a anotação "reprovado pelo cliente" */
    padding: clamp(4rem, 9vh, 5.5rem) var(--margem) clamp(4rem, 12vh, 8rem);
    max-width: calc(46rem + 2 * var(--margem));
    position: relative;
  }
  .rafe {
    position: relative;
    width: fit-content;
    padding-right: clamp(0rem, 8vw, 8rem);
  }
  .codigo {
    position: relative;
    display: block;
    font: inherit;
    color: var(--tinta);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }
  .digitos {
    display: block;
    font-family: var(--display);
    font-size: clamp(9rem, 36vw, 26rem);
    line-height: 0.8;
    font-weight: 900;
    white-space: nowrap;
  }
  .alvo {
    position: relative;
    display: inline-block;
    transform-origin: bottom center;
    transition:
      font-weight 0.6s cubic-bezier(0.23, 1, 0.32, 1),
      color 0.6s cubic-bezier(0.23, 1, 0.32, 1),
      transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);
  }
  /* pedido atendido: o "04" ganha outro peso, a cor de destaque e fica bem inclinado.
     A Big Shoulders não tem itálico de verdade; a inclinação é feita com skew. */
  .codigo[aria-pressed='true'] .alvo {
    font-weight: 300;
    color: var(--caneta);
    transform: skewX(-16deg);
  }
  /* círculo mal feito, à mão, só em volta do "04": não fecha e passa um pouco do ponto de partida */
  .circulo {
    position: absolute;
    /* folga em volta dos dígitos: o traço contorna o "04" em vez de cruzar o preto */
    inset: -24% -14% -22% -12%;
    width: 126%;
    height: 146%;
    overflow: visible;
    pointer-events: none;
    rotate: -4deg;
  }
  .circulo path {
    fill: none;
    stroke: var(--caneta);
    /* sem vector-effect: com ele o tracejado ignora o pathLength e o círculo sai pela metade.
       A espessura fica um pouco irregular com a escala, o que ajuda o ar de feito à mão. */
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    /* intervalo maior que o traço: antes de desenhar não sobra a bolinha da ponta arredondada */
    stroke-dasharray: 1 2;
    stroke-dashoffset: 1.5;
    animation: circular 0.9s cubic-bezier(0.65, 0, 0.35, 1) 0.2s forwards;
  }
  @keyframes circular {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* anotações à mão, na caneta de destaque, levemente tortas */
  .nota {
    position: absolute;
    color: var(--caneta);
    font-weight: 600;
    font-size: clamp(0.95rem, 1.8vw, 1.25rem);
    white-space: nowrap;
    opacity: 0;
    animation: anotar 0.4s ease-out forwards;
  }
  /* fica sobre o primeiro "4", fora do círculo, para o traço não passar por cima do texto */
  .nota-1 {
    top: -2.4rem;
    left: 0;
    rotate: -3deg;
    animation-delay: 1s;
  }
  .nota-2 {
    bottom: -2.6rem;
    right: 0;
    rotate: -4deg;
    animation-delay: 1.3s;
  }
  @keyframes anotar {
    from {
      opacity: 0;
      translate: 0 0.4rem;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  .notas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin-top: 3.75rem;
    color: var(--caneta);
    font-size: var(--t-sm);
  }
  .notas span {
    color: var(--grafite);
  }
  h1 {
    margin-top: 2rem;
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(2rem, 5vw, 3.4rem);
    line-height: 0.95;
    text-transform: uppercase;
  }
  .texto {
    margin-top: 0.9rem;
    max-width: 36rem;
    font-size: var(--t-md);
    line-height: 1.4;
  }
  .texto.secundario {
    font-size: var(--t-base);
  }
  .atalhos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2rem;
  }
  .atalhos a {
    padding: 0.7rem 1.1rem;
    border: 1px solid var(--tinta);
    font-weight: 600;
    text-decoration: none;
  }
  .atalhos a:first-child,
  .atalhos a:hover,
  .atalhos a:focus-visible {
    background: var(--caneta);
    border-color: var(--caneta);
    color: var(--papel);
  }

  .jogo {
    margin-top: clamp(3rem, 8vh, 4.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--linha);
  }
  .jogo h2 {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    line-height: 1;
    text-transform: uppercase;
  }
  .jogo > .secundario {
    margin-top: 0.35rem;
    font-size: var(--t-sm);
  }
  .jogo-palco {
    position: relative;
    margin-top: 1rem;
  }
  .jogo canvas {
    display: block;
    width: 100%;
    height: 220px;
    touch-action: manipulation;
    cursor: pointer;
  }
  .jogo-aviso {
    position: absolute;
    left: 0;
    right: 0;
    top: 38%;
    text-align: center;
    font-weight: 600;
    pointer-events: none;
  }
  .jogo-placar {
    margin-top: 0.5rem;
    font-size: var(--t-sm);
    color: var(--grafite);
  }

  /* stickers: no computador ficam no espaço livre à direita; no celular só um, pequeno, no canto */
  .erro :global(.sticker-erro-1) {
    top: 7rem;
    right: -15rem;
    --largura: 12rem;
  }
  .erro :global(.sticker-erro-2) {
    top: 20rem;
    right: -17rem;
    --largura: 13rem;
  }
  .erro :global(.sticker-erro-3) {
    top: 28rem;
    right: -10rem;
    --largura: 11rem;
  }
  @media (max-width: 1180px) {
    .erro :global(.sticker-erro-3) {
      top: 13rem;
      right: var(--margem);
      --largura: 5.5rem;
    }
    .erro :global(.sticker-erro-1) {
      top: 0.8rem;
      right: var(--margem);
      --largura: 7.5rem;
    }
    .erro :global(.sticker-erro-2) {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .rafe {
      padding-right: 0;
    }
    /* no celular a nota do pedido cresce para a direita, a partir da margem, e nunca sai da tela */
    .nota-2 {
      right: auto;
      left: 0;
    }
    .notas {
      flex-direction: column;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .circulo path {
      stroke-dashoffset: 0;
    }
    .nota {
      opacity: 1;
    }
  }
</style>

<script>
  import { iniciarJogo } from '../jogo-refacao';
  // joguinho só começa quando a pessoa pede (espaço, seta ou toque)
  document.addEventListener('astro:page-load', () => {
    const canvas = document.querySelector<HTMLCanvasElement>('[data-jogo]');
    const placar = document.querySelector<HTMLElement>('[data-jogo-placar]');
    const aviso = document.querySelector<HTMLElement>('[data-jogo-aviso]');
    if (canvas && placar && aviso) iniciarJogo(canvas, placar, aviso);
  });

  // Clique no 404: atende o pedido "dar mais destaque" (o "04" muda de peso e de cor). Outro clique desfaz.
  document.addEventListener('astro:page-load', () => {
    const botao = document.querySelector<HTMLElement>('[data-logo]');
    const pedido = document.querySelector<HTMLElement>('[data-pedido]');
    if (!botao || !pedido) return;
    botao.addEventListener('click', () => {
      const atendido = botao.getAttribute('aria-pressed') !== 'true';
      botao.setAttribute('aria-pressed', String(atendido));
      pedido.textContent = atendido ? 'agora sim, aprovado' : 'dar mais destaque';
    });
  });
</script>
