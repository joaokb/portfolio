---
// Stickers em SVG inline (assim usam as fontes do site). Estilo die-cut: borda branca grossa e sombra leve,
// nas cores do site com um acento amarelo. Ao passar o mouse, "descolam": sobem e giram um pouco.
// Uso: <Sticker nome="aprovado" style="top: 10%; right: 4%; --giro: -8deg; --largura: 9rem" />
interface Props {
  nome: 'aprovado' | 'refacao' | 'aumenta' | 'prazo' | 'selo' | 'etiqueta' | 'arquivo' | 'feito' | 'quatro' | 'freela' | 'linkbio' | 'remoto' | 'caneta' | 'checklist' | 'bateria';
  style?: string;
  class?: string;
}
const { nome, style, class: classe } = Astro.props;
const D = "'Big Shoulders Display Variable', 'Display Fallback', sans-serif";
const T = "'Schibsted Grotesk Variable', Arial, sans-serif";
const CANETA = 'var(--caneta, #1f2bd1)';
const PAPEL = '#e4e5e0';
const AMARELO = '#ffd60a';
// código de barras fixo (não muda a cada build)
const barras = [3, 1, 2, 1, 1, 3, 1, 2, 2, 1, 3, 1, 1, 2, 1, 3, 2, 1, 1, 2, 3, 1, 2, 1, 1, 3, 1, 2];
let bx = 22;
const listaBarras = barras.map((w, i) => {
  const r = { x: bx, w: w * 1.5, preta: i % 2 === 0 };
  bx += w * 1.5 + 1.4;
  return r;
});
// estrela de 16 pontas para o "aumenta o logo"
const estrela = (r1: number, r2: number) =>
  Array.from({ length: 32 }, (_, i) => {
    const a = (Math.PI * i) / 16 - Math.PI / 2;
    const r = i % 2 ? r2 : r1;
    return `${(100 + r * Math.cos(a)).toFixed(1)},${(100 + r * Math.sin(a)).toFixed(1)}`;
  }).join(' ');
---

<span class:list={['sticker', classe]} style={style} aria-hidden="true">
  {
    nome === 'aprovado' && (
      <svg viewBox="0 0 230 96">
        <rect x="2" y="2" width="226" height="92" rx="24" fill="#fff" />
        <rect x="10" y="10" width="210" height="76" rx="17" fill={CANETA} />
        <text x="115" y="62" text-anchor="middle" font-family={D} font-weight="800" font-size="48" fill={PAPEL} letter-spacing="1">APROVADO</text>
        <text x="115" y="78" text-anchor="middle" font-family={T} font-weight="600" font-size="10" fill={PAPEL} letter-spacing="2">DE PRIMEIRA</text>
      </svg>
    )
  }
  {
    nome === 'refacao' && (
      <svg viewBox="0 0 250 90">
        <rect x="2" y="2" width="246" height="86" rx="43" fill="#fff" />
        <rect x="10" y="10" width="230" height="70" rx="35" fill="#000" />
        <circle cx="40" cy="45" r="8" fill={CANETA} />
        {/* texto travado entre a bolinha e a borda, com a mesma folga dos dois lados */}
        <text x="62" y="58" textLength="156" lengthAdjust="spacingAndGlyphs" font-family={D} font-weight="800" font-size="36" fill={PAPEL}>REFAÇÃO Nº 3</text>
      </svg>
    )
  }
  {
    nome === 'aumenta' && (
      <svg viewBox="0 0 200 200">
        <polygon points={estrela(98, 84)} fill="#fff" />
        <polygon points={estrela(88, 74)} fill={AMARELO} />
        <g transform="rotate(-10 100 100)">
          <text x="100" y="96" text-anchor="middle" font-family={D} font-weight="900" font-size="38" fill="#000">AUMENTA</text>
          <text x="100" y="132" text-anchor="middle" font-family={D} font-weight="900" font-size="38" fill="#000">O LOGO</text>
        </g>
      </svg>
    )
  }
  {
    nome === 'prazo' && (
      <svg viewBox="0 0 280 100">
        <defs>
          <pattern id="sticker-listras" width="22" height="22" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
            <rect width="22" height="22" fill={AMARELO} />
            <rect width="11" height="22" fill="#000" />
          </pattern>
        </defs>
        <rect x="2" y="2" width="276" height="96" rx="12" fill="#fff" />
        <rect x="10" y="10" width="260" height="80" rx="6" fill="url(#sticker-listras)" />
        <rect x="46" y="22" width="188" height="56" fill="#fff" />
        <text x="140" y="62" text-anchor="middle" font-family={D} font-weight="800" font-size="34" fill="#000">PRAZO: ONTEM</text>
      </svg>
    )
  }
  {
    nome === 'selo' && (
      <svg viewBox="0 0 200 200">
        <defs>
          <path id="sticker-anel" d="M100,100 m-66,0 a66,66 0 1,1 132,0 a66,66 0 1,1 -132,0" />
        </defs>
        <circle cx="100" cy="100" r="98" fill="#fff" />
        <circle cx="100" cy="100" r="89" fill={CANETA} />
        <circle cx="100" cy="100" r="48" fill="none" stroke={PAPEL} stroke-width="2" />
        <text font-family={T} font-weight="700" font-size="14.5" fill={PAPEL} letter-spacing="2.4">
          <textPath href="#sticker-anel">JOÃO KAVALCHUK ● DIRETOR DE ARTE ●</textPath>
        </text>
        <text x="100" y="121" text-anchor="middle" font-family={D} font-weight="900" font-size="60" fill={PAPEL}>KB</text>
      </svg>
    )
  }
  {
    nome === 'etiqueta' && (
      <svg viewBox="0 0 240 132">
        <rect x="2" y="2" width="236" height="128" rx="12" fill="#fff" />
        <rect x="10" y="10" width="220" height="112" rx="5" fill="#f4f4f1" stroke="#000" stroke-width="2.5" />
        {listaBarras.filter((b) => b.preta).map((b) => <rect x={b.x} y="22" width={b.w} height="34" fill="#000" />)}
        <text x="218" y="40" text-anchor="end" font-family={T} font-weight="700" font-size="12" fill="#000">KB—2026</text>
        <text x="218" y="56" text-anchor="end" font-family={T} font-weight="500" font-size="9" fill="#5b5d57">LOTE 07</text>
        <line x1="22" y1="68" x2="218" y2="68" stroke="#000" stroke-width="1.5" />
        <text x="22" y="96" textLength="196" lengthAdjust="spacingAndGlyphs" font-family={D} font-weight="800" font-size="27" fill="#000">ART DIRECTION DEPT.</text>
        <text x="22" y="112" textLength="196" lengthAdjust="spacingAndGlyphs" font-family={T} font-weight="600" font-size="9" fill={CANETA}>PRESIDENTE PRUDENTE / SP / BRASIL</text>
      </svg>
    )
  }
  {
    nome === 'arquivo' && (
      <svg viewBox="0 0 270 76">
        <rect x="2" y="2" width="266" height="72" rx="16" fill="#fff" />
        <rect x="10" y="10" width="250" height="56" rx="10" fill="#000" />
        <text x="135" y="46" text-anchor="middle" font-family={T} font-weight="600" font-size="20" fill={PAPEL}>
          v3_final_<tspan fill={AMARELO} font-weight="800">FINAL</tspan>.psd
        </text>
      </svg>
    )
  }
  {
    nome === 'feito' && (
      <svg viewBox="0 0 230 86">
        <rect x="2" y="2" width="226" height="82" rx="10" fill="#fff" />
        <rect x="10" y="10" width="210" height="66" rx="4" fill={PAPEL} stroke="#000" stroke-width="3" />
        <text x="115" y="56" text-anchor="middle" font-family={D} font-weight="800" font-size="38" fill="#000">FEITO À MÃO<tspan font-size="18" dy="-16">™</tspan></text>
      </svg>
    )
  }
  {
    /* faca de corte que acompanha o contorno do "04": o traço branco grosso atrás do texto é a borda do recorte */
    nome === 'quatro' && (
      <svg viewBox="0 0 160 130">
        <g transform="skewX(-10)" transform-origin="80 65" font-family={D} font-weight="900" font-size="132" text-anchor="middle">
          <text x="80" y="112" fill="#fff" stroke="#fff" stroke-width="18" stroke-linejoin="round">04</text>
          <text x="80" y="112" fill="#000" stroke="#000" stroke-width="6" stroke-linejoin="round">04</text>
          <text x="80" y="112" fill={CANETA}>04</text>
        </g>
      </svg>
    )
  }
  {
    nome === 'freela' && (
      <svg viewBox="0 0 250 92">
        <rect x="2" y="2" width="246" height="88" rx="44" fill="#fff" />
        <rect x="10" y="10" width="230" height="72" rx="36" fill={CANETA} />
        <circle cx="44" cy="46" r="11" fill={AMARELO} />
        <circle cx="44" cy="46" r="17" fill="none" stroke={AMARELO} stroke-width="2" opacity="0.5" />
        <text x="72" y="52" textLength="146" lengthAdjust="spacingAndGlyphs" font-family={D} font-weight="800" font-size="34" fill={PAPEL}>DISPONÍVEL</text>
        <text x="72" y="69" textLength="146" lengthAdjust="spacingAndGlyphs" font-family={T} font-weight="700" font-size="10" fill={PAPEL}>PARA FREELA</text>
      </svg>
    )
  }
  {
    /* recorte segue o contorno: traço branco grosso atrás do texto e da seta */
    nome === 'linkbio' && (
      <svg viewBox="0 0 200 180">
        <g stroke="#fff" stroke-width="16" stroke-linejoin="round" stroke-linecap="round" fill="#fff">
          <text x="100" y="58" text-anchor="middle" font-family={D} font-weight="900" font-size="54">LINK NA</text>
          <text x="100" y="108" text-anchor="middle" font-family={D} font-weight="900" font-size="54">BIO</text>
          <path d="M150 96 C 176 112, 170 146, 132 160" fill="none" />
          <path d="M132 160 L 146 142 M132 160 L 152 166" fill="none" />
        </g>
        <text x="100" y="58" text-anchor="middle" font-family={D} font-weight="900" font-size="54" fill="#000">LINK NA</text>
        <text x="100" y="108" text-anchor="middle" font-family={D} font-weight="900" font-size="54" fill={CANETA}>BIO</text>
        <g stroke={CANETA} stroke-width="5" stroke-linecap="round" stroke-linejoin="round" fill="none">
          <path d="M150 96 C 176 112, 170 146, 132 160" />
          <path d="M132 160 L 146 142 M132 160 L 152 166" />
        </g>
      </svg>
    )
  }
  {
    nome === 'remoto' && (
      <svg viewBox="0 0 280 118">
        <path d="M30 2 H270 a8 8 0 0 1 8 8 V108 a8 8 0 0 1 -8 8 H30 L2 88 V30 Z" fill="#fff" />
        <path d="M34 10 H262 a6 6 0 0 1 6 6 V102 a6 6 0 0 1 -6 6 H34 L10 84 V34 Z" fill={PAPEL} stroke="#000" stroke-width="2.5" />
        <circle cx="34" cy="59" r="7" fill="#fff" stroke="#000" stroke-width="2.5" />
        <rect x="54" y="20" width="204" height="24" fill={CANETA} />
        <text x="156" y="38" text-anchor="middle" font-family={T} font-weight="700" font-size="13" fill={PAPEL} letter-spacing="3">REMOTO OK</text>
        <text x="58" y="66" textLength="196" lengthAdjust="spacingAndGlyphs" font-family={T} font-weight="600" font-size="12" fill="#5b5d57">PRESIDENTE PRUDENTE / SP</text>
        <text x="58" y="98" textLength="196" lengthAdjust="spacingAndGlyphs" font-family={D} font-weight="800" font-size="32" fill="#000">→ QUALQUER LUGAR</text>
      </svg>
    )
  }
  {
    nome === 'caneta' && (
      <svg viewBox="0 0 250 104">
        <rect x="2" y="2" width="246" height="100" rx="10" fill="#fff" />
        <rect x="10" y="10" width="230" height="84" rx="4" fill="#000" />
        <text x="24" y="50" textLength="202" lengthAdjust="spacingAndGlyphs" font-family={D} font-weight="900" font-size="36" fill={PAPEL}>NÃO EMPRESTO</text>
        <text x="24" y="80" textLength="202" lengthAdjust="spacingAndGlyphs" font-family={D} font-weight="900" font-size="28" fill={AMARELO}>MINHA CANETA</text>
      </svg>
    )
  }
  {
    nome === 'checklist' && (
      <svg viewBox="0 0 180 214">
        <rect x="2" y="2" width="176" height="210" rx="12" fill="#fff" />
        <rect x="10" y="10" width="160" height="194" rx="5" fill="#f4f4f1" stroke="#000" stroke-width="2.5" />
        <rect x="10" y="10" width="160" height="38" rx="5" fill="#000" />
        <text x="90" y="37" text-anchor="middle" textLength="134" lengthAdjust="spacingAndGlyphs" font-family={D} font-weight="900" font-size="24" fill={PAPEL}>ANTES DE SAIR</text>
        {['CADERNO', 'CANETA', 'FONE', 'RELÓGIO', 'COPO'].map((item, n) => (
          <g transform={`translate(0 ${n * 30})`}>
            <rect x="24" y="60" width="18" height="18" fill="none" stroke="#000" stroke-width="2" />
            <path d="M26 69 L32 76 L46 56" fill="none" stroke={CANETA} stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
            <text x="54" y="77" font-family={D} font-weight="800" font-size="21" fill="#000">{item}</text>
          </g>
        ))}
      </svg>
    )
  }
  {
    nome === 'bateria' && (
      <svg viewBox="0 0 230 104">
        <rect x="2" y="2" width="212" height="100" rx="18" fill="#fff" />
        <rect x="196" y="32" width="32" height="40" rx="8" fill="#fff" />
        <rect x="12" y="12" width="192" height="80" rx="11" fill="#000" />
        <rect x="204" y="38" width="14" height="28" rx="4" fill="#000" />
        <rect x="20" y="20" width="176" height="64" rx="6" fill={AMARELO} />
        <text x="108" y="70" text-anchor="middle" font-family={D} font-weight="900" font-size="54" fill="#000">100%</text>
      </svg>
    )
  }
</span>

<style>
  .sticker {
    position: absolute;
    z-index: 3;
    display: block;
    width: var(--largura, 9rem);
    rotate: var(--giro, 0deg);
    filter: drop-shadow(0 2px 2px rgb(0 0 0 / 0.12)) drop-shadow(0 6px 10px rgb(0 0 0 / 0.1));
    transition:
      translate 0.35s cubic-bezier(0.23, 1, 0.32, 1),
      rotate 0.35s cubic-bezier(0.23, 1, 0.32, 1),
      scale 0.35s cubic-bezier(0.23, 1, 0.32, 1),
      filter 0.35s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .sticker svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  /* descolar: sobe, gira um pouco e a sombra cresce */
  @media (hover: hover) and (pointer: fine) {
    .sticker:hover {
      translate: 0 -6px;
      rotate: calc(var(--giro, 0deg) + 4deg);
      scale: 1.06;
      filter: drop-shadow(0 4px 4px rgb(0 0 0 / 0.14)) drop-shadow(0 14px 22px rgb(0 0 0 / 0.16));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sticker {
      transition: none;
    }
  }
  /* no PDF/impressão os stickers saem */
  @media print {
    .sticker {
      display: none;
    }
  }
</style>
