---
// Everyday carry: o que João carrega todo dia. Itens em src/data/edc.json (editável no /admin).
// Fotos sem fundo (scripts/recortar-fundo.mjs), em preto e branco que ganham cor no hover, como os logos.
import Base from '../layouts/Base.astro';
import perfil from '../data/perfil.json';
import edc from '../data/edc.json';
import { rota, type Lang } from '../i18n';
import { srcset } from '../imagens';
import Sticker from './Sticker.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const en = lang === 'en';
---

<Base title={`Everyday carry, ${perfil.nome}`} description={en ? 'What I carry every day.' : 'O que eu carrego todo dia.'}>
  <section class="edc">
    <Sticker nome="checklist" style="top: var(--topo-checklist, clamp(1.5rem, 6vh, 4rem)); left: 5%; --giro: -8deg; --largura: clamp(5rem, 10vw, 9rem)" />
    <Sticker nome="caneta" style="top: var(--topo-caneta, clamp(2rem, 7vh, 4.5rem)); right: 5%; --giro: 7deg; --largura: clamp(7rem, 14vw, 12rem)" />
    <h1>Everyday carry</h1>
    <p class="intro">{en ? 'What I carry every day' : 'O que eu carrego todo dia'}</p>
    <ul class="grade">
      {
        edc.itens.map((i, n) => (
          <li class="item">
            {/fone/i.test(i.tipo) && <Sticker nome="bateria" style="top: -0.9rem; right: -0.7rem; --giro: 9deg; --largura: 7.5rem" />}
            <img
              src={i.imagem.replace(/\.webp$/, '.min.webp')}
              srcset={srcset(i.imagem)}
              sizes="(max-width: 480px) 62vw, (max-width: 760px) 40vw, (max-width: 1100px) 26vw, 240px"
              width="1200"
              height="1200"
              alt={i.nome}
              loading={n < 3 ? 'eager' : 'lazy'}
              decoding="async"
            />
            <p class="tipo">{en ? i.tipo_en || i.tipo : i.tipo}</p>
            <h2>{i.nome}</h2>
            <p class="texto">{en ? i.texto_en || i.texto : i.texto}</p>
          </li>
        ))
      }
    </ul>
    <p class="voltar"><a href={rota(lang, '/sobre/')}>{en ? 'More about me' : 'Mais sobre mim'}</a></p>
  </section>
</Base>

<style>
  /* página centrada, itens em caixas no estilo de vitrine de produto (pedido do João) */
  .edc {
    position: relative;
    padding: clamp(2.5rem, 8vh, 5rem) var(--margem) clamp(4rem, 12vh, 8rem);
    text-align: center;
  }
  h1 {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(3.4rem, 9vw, 8rem);
    line-height: 0.86;
    text-transform: uppercase;
  }
  .intro {
    margin-top: 0.9rem;
    font-size: var(--t-md);
    color: var(--grafite);
  }
  /* flex em vez de grid: a última linha incompleta fica centralizada */
  .grade {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem;
    max-width: 78rem;
    margin: clamp(2.5rem, 6vh, 4rem) auto 0;
  }
  .item {
    position: relative;
    flex: 0 1 calc((100% - 3 * 1.25rem) / 4);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1.6rem 1.4rem 1.8rem;
    background: #f4f4f1;
    border-radius: 28px;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.04),
      0 8px 24px rgb(0 0 0 / 0.06);
    transition:
      transform 0.35s cubic-bezier(0.23, 1, 0.32, 1),
      box-shadow 0.35s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .item:hover {
    transform: translateY(-4px);
    box-shadow:
      0 2px 4px rgb(0 0 0 / 0.05),
      0 16px 40px rgb(0 0 0 / 0.1);
  }
  .item img {
    width: 78%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    filter: grayscale(1);
    transition: filter 0.3s;
  }
  .item:hover img {
    filter: none;
  }
  /* no toque não há hover: a cor fica */
  @media (hover: none) {
    .item img {
      filter: none;
    }
  }
  .tipo {
    margin-top: 0.9rem;
    font-size: var(--t-sm);
    color: var(--grafite);
  }
  h2 {
    margin-top: 0.2rem;
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.6rem;
    line-height: 0.95;
    text-transform: uppercase;
  }
  .item:hover h2 {
    color: var(--caneta);
  }
  .texto {
    margin-top: 0.55rem;
    font-size: var(--t-sm);
    line-height: 1.45;
    color: var(--grafite);
  }
  .voltar {
    margin-top: clamp(3rem, 8vh, 5rem);
    font-weight: 600;
  }
  @media (prefers-reduced-motion: reduce) {
    .item,
    .item:hover {
      transform: none;
    }
  }
  @media (max-width: 1100px) {
    .item {
      flex-basis: calc((100% - 2 * 1.25rem) / 3);
    }
  }
  @media (max-width: 760px) {
    .item {
      flex-basis: calc((100% - 1.25rem) / 2);
    }
  }
  @media (max-width: 480px) {
    .grade {
      gap: 1rem;
    }
    .item {
      flex-basis: 100%;
      max-width: 22rem;
    }
    .item img {
      width: 62%;
    }
  }
  /* no celular os dois stickers ganham uma faixa própria acima do título, sem cobrir o texto */
  @media (max-width: 760px) {
    .edc {
      padding-top: 8.5rem;
      --topo-checklist: 0.8rem;
      --topo-caneta: 2.2rem;
    }
  }
</style>
