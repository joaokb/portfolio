---
import Base from '../layouts/Base.astro';
import perfil from '../data/perfil.json';
import { readFileSync, existsSync } from 'node:fs';
import { imageSize } from 'image-size';
import { ui, rota, textoPerfil, type Lang } from '../i18n';
import { medidas, srcset } from '../imagens';
import Sticker from './Sticker.astro';
import { publicados, dadosEn } from '../projetos';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const tp = textoPerfil(lang);

// prévia pequena: miniatura .min.webp (scripts/otimizar-imagens.mjs) ou a versão de 632px do Behance
const capa = (src: string) => {
  const mini = src.replace(/\.webp$/, '.min.webp');
  if (mini !== src && existsSync(`public${decodeURI(mini)}`)) return mini;
  return src.replace(/(behance\.net\/project_modules\/)[^/]+\//, '$1max_632/');
};

// logos com o mesmo peso: área constante, então logo largo fica baixo e logo alto fica estreito
const AREA = 4.1; // altura em rem de um logo quadrado
function tamanhoLogo(src: string) {
  try {
    const { width, height } = imageSize(readFileSync(`public${decodeURI(src)}`));
    const ar = width! / height!;
    return `height:${(AREA / Math.sqrt(ar)).toFixed(2)}rem;width:${Math.min(AREA * Math.sqrt(ar), 10).toFixed(2)}rem`;
  } catch {
    return ''; // logo externo ou ilegível: cai na caixa padrão do CSS
  }
}

const projetos = (await publicados()).map((p) => ({ id: p.id, data: lang === 'en' ? dadosEn(p.data) : p.data }));
const letras = [...perfil.nome.toUpperCase()];
const voltaFormulario = new URL(rota(lang, '/?enviado=1#contato'), Astro.site).href;
---

<Base>
  <section class="abertura">
    <Sticker nome="aprovado" style="top: clamp(0.9rem, 2vw, 1.6rem); right: 3%; --giro: 7deg; --largura: clamp(5rem, 9vw, 9rem)" />
    <Sticker nome="selo" style="top: calc(clamp(1.5rem, 5vh, 3.5rem) + 7vw); left: 1%; --giro: -12deg; --largura: clamp(4.5rem, 8vw, 8.5rem)" />
    <h1 class="nome" aria-label={`${perfil.nome}, ${tp.cargo.toLowerCase()}`} data-nome style={`--len:${letras.length}`}>
      {letras.map((l, i) => <span class="letra" aria-hidden="true" style={`--i:${i}`}>{l === ' ' ? ' ' : l}</span>)}
    </h1>

    <div class="letreiro" aria-hidden="true">
      {
        [0, 1].map(() => (
          <p class="letreiro-trilho">
            {t.faixa.map((f) => (
              <span>
                {f}
                <span class="ponto" />
              </span>
            ))}
          </p>
        ))
      }
    </div>

    <div class="faixa" data-faixa>
      {
        [0, 1].map((copia) => (
          <ul class="faixa-trilho" aria-hidden={copia ? 'true' : undefined}>
            {projetos.map((p, i) => {
              const original = p.data.preview || p.data.cover;
              const { w, h } = medidas(original);
              const r = w && h ? w / h : 1.5;
              return (
              <li>
                <a href={rota(lang, `/projetos/${p.id}/`)} tabindex={copia ? -1 : undefined}>
                  {/* altura da faixa: 7.5rem no celular, até 13rem; a largura acompanha a proporção */}
                  <img
                    src={capa(original)}
                    srcset={srcset(original)}
                    sizes={`(max-width: 760px) ${Math.ceil(r * 120)}px, ${Math.ceil(r * 208)}px`}
                    width={w}
                    height={h}
                    alt={copia ? '' : p.data.title}
                    loading={!copia && i < 6 ? 'eager' : 'lazy'}
                    fetchpriority={!copia && i === 0 ? 'high' : 'auto'}
                    decoding="async"
                  />
                </a>
              </li>
              );
            })}
          </ul>
        ))
      }
    </div>

    <div class="intro">
      <Sticker nome="quatro" style="top: var(--topo-04, -6rem); right: 3%; --giro: 12deg; --largura: clamp(5.5rem, 9vw, 9rem)" />
      <p class="cargo">
        {tp.cargo}
        <span class="status"><span class="ponto" aria-hidden="true"></span>{tp.status}</span>
      </p>
      <p class="apresentacao">{tp.bio}</p>
    </div>
  </section>

  <section id="trabalhos" class="indice" aria-labelledby="titulo-trabalhos">
    <h2 id="titulo-trabalhos" class="visualmente-oculto">{t.trabalhos}</h2>
    <ol class="lista" data-indice>
      {
        projetos.map((p) => (
          <li class="item" data-capa={capa(p.data.preview || p.data.cover)} style={`--len:${p.data.title.length}`}>
            <a href={rota(lang, `/projetos/${p.id}/`)} class="link">
              <span class="cabeca">
                {/* pasta do case: fechada no peso fino, abre e ganha a caneta quando o título passa pelo centro */}
                <svg class="pasta" viewBox="0 0 24 20" aria-hidden="true">
                  <path class="pasta-fundo" d="M2 4a2 2 0 0 1 2-2h5l2 2.5h9a2 2 0 0 1 2 2V17a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2Z" />
                  <path class="pasta-frente" d="M2 8.5h20V17a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2Z" />
                </svg>
                <span class="titulo" data-id={p.id}>
                  {p.data.title}
                </span>
              </span>
              <img
                class:list={['miniatura', { logo: p.data.logo }]}
                src={p.data.logo || capa(p.data.preview || p.data.cover)}
                style={p.data.logo ? tamanhoLogo(p.data.logo) : undefined}
                alt=""
                loading="lazy"
                decoding="async"
              />
              <span class="ficha">
                <span class="ano">{p.data.year}</span>
                <span>{p.data.discipline}</span>
                <span class="secundario">{p.data.client}</span>
                {p.data.award && <span class="premio">{p.data.award}</span>}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <div class="previa" data-previa aria-hidden="true"><img alt="" data-previa-img /></div>

  <section id="premios" class="premios" aria-labelledby="titulo-premios">
    <h2 id="titulo-premios" class="rotulo">{t.premios}</h2>
    <ul>
      {
        perfil.premios.map((p) => (
          <li>
            <span class="ano">{p.ano}</span>
            <span class:list={['nivel', { ouro: p.nivel === 'Ouro' }]}>{tp.tr(p.nivel)}{/(Ouro|Prata|Bronze)/.test(p.nivel) && <img class="trofeu" src="/emoji/trofeu.webp" alt="" width="64" height="64" loading="lazy" />}</span>
            <span>{p.festival}</span>
            <span class="secundario">{p.slug ? <a href={rota(lang, `/projetos/${p.slug}/`)}>{p.projeto}</a> : p.projeto}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="contato" class="contato" aria-labelledby="titulo-contato">
    <h2 id="titulo-contato" class="rotulo">{t.contato}</h2>
    <div class="contato-grade">
      <div>
        <a class="email" href={`mailto:${perfil.email}`}>{perfil.email}</a>
        <ul class="links">
          {perfil.links.map((l) => <li><a href={l.url} rel="me noopener" target="_blank">{tp.tr(l.nome)}</a></li>)}
          <li class="secundario">{tp.tr(perfil.cidade)}</li>
        </ul>
      </div>
      <!-- shortcut: FormSubmit entrega por e-mail sem backend; o primeiro envio pede ativação no e-mail do João -->
      <form class="form" action={`https://formsubmit.co/${perfil.email}`} method="POST">
        <h3 class="form-titulo">{t.msgTitulo}</h3>
        <p class="enviado" data-enviado hidden role="status">{t.enviado}</p>
        <input type="hidden" name="_subject" value={lang === 'en' ? 'Portfolio message' : 'Mensagem pelo portfólio'} />
        <input type="hidden" name="_next" value={voltaFormulario} />
        <input type="hidden" name="_template" value="table" />
        <input type="text" name="_honey" class="visualmente-oculto" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <label>
          <span>{t.nome}</span>
          <input type="text" name="nome" required maxlength="120" autocomplete="name" />
        </label>
        <label>
          <span>{t.email}</span>
          <input type="email" name="email" required maxlength="200" autocomplete="email" />
        </label>
        <label>
          <span>{t.mensagem}</span>
          <textarea name="mensagem" required rows="4" maxlength="3000"></textarea>
        </label>
        <button type="submit">{t.enviar}</button>
      </form>
    </div>
  </section>
</Base>

<style>
  /* Primeira dobra: nome cinético, faixa de capas e apresentação */
  .abertura {
    position: relative;
    padding: clamp(1.5rem, 5vh, 3.5rem) 0 clamp(3rem, 9vh, 6rem);
    container-type: inline-size;
  }
  .nome {
    display: flex;
    justify-content: center;
    padding-inline: var(--margem);
    font-family: var(--display);
    /* o nome ocupa a largura toda e ainda cabe com todas as letras no peso 900 (medido: 2.27) */
    font-size: calc((100cqi - 2 * var(--margem)) * 2.24 / var(--len));
    line-height: 0.82;
    text-transform: uppercase;
    white-space: nowrap;
    /* altura fixa e layout isolado: o peso das letras mudando (cursor, onda) não recalcula o resto da página */
    height: 0.82em;
    contain: layout style;
  }
  .nome.parado .letra {
    animation-play-state: paused;
  }
  /* fino em repouso; o cursor engrossa as letras perto dele */
  .letra {
    font-weight: var(--w, 300);
    /* --k (0 a 1) vem do cursor: quanto mais perto, mais cor de destaque */
    color: color-mix(in srgb, var(--caneta) calc(var(--k, 0) * 100%), var(--tinta));
    transition:
      font-weight 0.45s cubic-bezier(0.23, 1, 0.32, 1),
      color 0.45s cubic-bezier(0.23, 1, 0.32, 1);
  }
  /* Toque (celular, tablet): sem cursor, uma onda de peso e cor passa pelo nome de tempos em tempos */
  @media (hover: none), (pointer: coarse) {
    .letra {
      animation: onda 4.5s cubic-bezier(0.45, 0, 0.55, 1) infinite;
      animation-delay: calc(1.2s + var(--i) * 70ms);
    }
  }
  @keyframes onda {
    0%,
    30%,
    100% {
      font-weight: 300;
      color: var(--tinta);
    }
    15% {
      font-weight: 900;
      color: var(--caneta);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .letra {
      transition: none;
      animation: none;
    }
  }

  /* Letreiro: funções correndo sem fim, no sentido contrário das capas */
  .letreiro {
    margin-top: clamp(1rem, 2.5vh, 1.75rem);
    display: flex;
    overflow: hidden;
    padding-block: 0.55rem;
    background: var(--caneta);
    color: var(--papel);
  }
  .letreiro .ponto {
    background: var(--papel);
  }
  .letreiro-trilho {
    display: flex;
    flex: none;
    animation: faixa 45s linear infinite reverse;
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(1.4rem, 3vw, 2.6rem);
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .letreiro-trilho > span {
    display: inline-flex;
    align-items: center;
  }
  .letreiro .ponto {
    margin-inline: 0.8em;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .letreiro-trilho {
      animation: none;
    }
  }

  .faixa {
    margin-top: clamp(1rem, 2.5vh, 1.75rem);
    display: flex;
    overflow: hidden;
    /* bordas somem no papel */
    mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
  }
  .faixa-trilho {
    display: flex;
    flex: none;
    gap: clamp(0.5rem, 1vw, 0.9rem);
    padding-right: clamp(0.5rem, 1vw, 0.9rem);
    animation: faixa 70s linear infinite;
  }
  .faixa:hover .faixa-trilho,
  .faixa:focus-within .faixa-trilho {
    animation-play-state: paused;
  }
  @keyframes faixa {
    to {
      transform: translateX(-100%);
    }
  }
  .faixa img {
    height: clamp(7.5rem, 15vw, 13rem);
    width: auto;
    max-width: none;
    filter: grayscale(1);
    transition: filter 0.3s;
    background: var(--papel-fundo);
  }
  .faixa a:hover img,
  .faixa a:focus-visible img {
    filter: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .faixa {
      overflow-x: auto;
    }
    .faixa-trilho {
      animation: none;
    }
    .faixa-trilho[aria-hidden] {
      display: none;
    }
  }

  .intro {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, var(--coluna));
    gap: 1rem 3rem;
    padding: clamp(1.5rem, 4vh, 2.5rem) var(--margem) 0;
  }
  .cargo {
    font-weight: 600;
    display: grid;
    gap: 0.4rem;
    align-content: start;
  }
  .apresentacao {
    font-size: var(--t-md);
    line-height: 1.35;
    text-wrap: pretty;
  }
  .status {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    font-weight: 420;
    color: var(--grafite);
  }
  @media (max-width: 760px) {
    .intro {
    position: relative;
      grid-template-columns: 1fr;
    }
    /* no celular a bio fica na página Sobre: a faixa e o índice sobem para a primeira tela */
    .apresentacao {
      display: none;
    }
  }
  .ponto {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--caneta);
    flex: none;
    transform: translateY(-0.05em);
  }

  /* Índice cinético */
  .indice {
    padding: 0 var(--margem) clamp(4rem, 14vh, 9rem);
  }
  .lista {
    container-type: inline-size;
  }
  .link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 11rem 15rem;
    align-items: start;
    column-gap: 2rem;
    padding-block: clamp(0.4rem, 1.2vw, 0.9rem);
    text-decoration: none;
    color: var(--tinta);
  }
  /* título + pasta. A pasta mora numa coluna de largura fixa (--slot), centralizada nela, e o vão até o título
     é o mesmo em todas as linhas: os títulos começam todos no mesmo x. A altura acompanha o título (em), com teto.
     Uma linha só, escala pelo comprimento para caber mesmo no peso máximo, descontando coluna e vão. */
  .lista {
    --slot: clamp(1.9rem, 3.4vw, 3.4rem);
    --vao: clamp(0.6rem, 1.2vw, 1.1rem);
  }
  .cabeca {
    display: flex;
    align-items: center;
    gap: var(--vao);
    font-size: min(clamp(3.1rem, 9.5vw, 10rem), calc((100cqi - 30rem - var(--slot) - var(--vao)) * 2 / var(--len)));
    min-width: 0;
  }
  .item {
    /* 0 com o título fino, 1 no peso máximo (o script do índice muda o --peso) */
    --abre: calc((var(--peso, 300) - 200) / 700);
  }
  .pasta {
    flex: none;
    /* o viewBox centraliza o desenho na coluna; a altura cresce com o título até caber na coluna */
    width: var(--slot);
    height: min(0.42em, var(--slot) * 0.83);
    /* centro das maiúsculas fica um pouco abaixo do centro da caixa da linha */
    translate: 0 0.04em;
    overflow: visible;
    stroke: color-mix(in srgb, var(--caneta) calc(var(--abre) * 100%), var(--grafite));
    stroke-width: calc(1 + var(--abre) * 1.6);
    stroke-linejoin: round;
  }
  .pasta-fundo {
    fill: none;
  }
  /* a frente da pasta tomba para a frente ao abrir e se enche de caneta */
  .pasta-frente {
    fill: color-mix(in srgb, var(--caneta) calc(var(--abre) * 100%), var(--papel));
    transform-box: fill-box;
    transform-origin: 50% 100%;
    transform: skewX(calc(var(--abre) * -22deg)) scaleY(calc(1 - var(--abre) * 0.3));
  }
  .item.ativo,
  .link:hover,
  .link:focus-visible {
    --abre: 1;
  }
  .titulo {
    display: block;
    font-family: var(--display);
    white-space: nowrap;
    font-size: inherit;
    line-height: 0.88;
    text-transform: uppercase;
    font-weight: var(--peso, 300);
    letter-spacing: -0.005em;
    width: fit-content;
    transition: color 0.2s;
  }
  @media (prefers-reduced-motion: reduce) {
    .titulo {
      font-weight: 600;
    }
    /* sem movimento: pasta parada, entreaberta, no mesmo peso dos títulos */
    .item {
      --abre: 0.55;
    }
  }
  .item.ativo .titulo,
  .link:hover .titulo,
  .link:focus-visible .titulo {
    color: var(--caneta);
  }
  /* miniatura em preto e branco: o trabalho aparece antes do hover */
  .miniatura {
    width: auto;
    max-width: 100%;
    height: 5.5rem;
    margin-top: 0.5em;
    justify-self: center;
    object-fit: contain;
    object-position: center top;
    filter: grayscale(1);
    transition: filter 0.2s;
  }
  /* logo: caixa fixa para marcas largas e altas ocuparem peso parecido */
  .miniatura.logo {
    width: 100%;
    height: 4rem;
    align-self: center;
    margin-top: 0;
    object-position: center;
    filter: grayscale(1) contrast(1.2);
    /* fundo branco de logo raster some no papel */
    mix-blend-mode: multiply;
  }
  .item.ativo .miniatura,
  .link:hover .miniatura,
  .link:focus-visible .miniatura {
    filter: none;
  }
  .ficha {
    display: grid;
    gap: 0.1rem;
    padding-top: 0.5em;
    font-size: var(--t-sm);
    line-height: 1.35;
  }
  /* logo e ficha dividem o mesmo centro vertical */
  @media (min-width: 761px) {
    .link {
      align-items: center;
    }
    .cabeca {
      align-self: start;
    }
    .ficha {
      padding-top: 0;
    }
  }
  /* Tablet: a ficha desce para baixo do título e o título ganha a largura; o logo fica à direita, no centro da linha */
  @media (min-width: 761px) and (max-width: 1100px) {
    .link {
      grid-template-columns: minmax(0, 1fr) 9rem;
      column-gap: 1.5rem;
    }
    .cabeca {
      grid-column: 1;
      grid-row: 1;
      font-size: min(clamp(3.1rem, 9.5vw, 10rem), calc((100cqi - 11rem - var(--slot) - var(--vao)) * 2 / var(--len)));
    }
    .ficha {
      grid-column: 1;
      grid-row: 2;
      grid-template-columns: auto auto 1fr;
      column-gap: 0.75rem;
      align-items: baseline;
      padding-top: 0.45rem;
    }
    .premio {
      grid-column: 1 / -1;
      margin-top: 0;
    }
    .miniatura {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }
  .ano {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .premio {
    margin-top: 0.35rem;
    color: var(--caneta);
  }

  @media (max-width: 760px) {
    .link {
      grid-template-columns: 1fr;
    }
    /* no toque a capa do canto já faz a prévia */
    .miniatura {
      display: none;
    }
    .cabeca {
      font-size: min(clamp(3.1rem, 9.5vw, 10rem), calc((100cqi - var(--slot) - var(--vao)) * 2 / var(--len)));
    }
    .ficha {
      grid-auto-flow: row;
      padding-top: 0.45rem;
      grid-template-columns: auto auto 1fr;
      column-gap: 0.75rem;
      align-items: baseline;
    }
    .premio {
      grid-column: 1 / -1;
      margin-top: 0;
    }
  }

  /* Prévia que segue o cursor (desktop) ou fica no canto (toque) */
  .previa {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 10;
    width: clamp(13rem, 24vw, 22rem);
    pointer-events: none;
    opacity: 0;
    translate: 24px -50%;
    transition: opacity 150ms cubic-bezier(0.23, 1, 0.32, 1);
    will-change: transform;
  }
  .previa.visivel {
    opacity: 1;
  }
  /* imagem inteira, sem recorte; alta (stories) fica limitada pela altura da tela */
  .previa img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 60vh;
  }
  @media not ((hover: hover) and (pointer: fine)) {
    .previa {
      translate: none;
      left: auto;
      top: auto;
      right: var(--margem);
      bottom: var(--margem);
      width: 9.5rem;
      transform: none !important;
    }
  }

  /* Blocos de texto */
  .rotulo {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(2.2rem, 5vw, 4rem);
    line-height: 0.9;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }
  .premios,
  .contato {
    padding: clamp(3rem, 10vh, 6rem) var(--margem);
  }
  .premios ul li {
    display: grid;
    grid-template-columns: 5rem 6rem minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--linha);
  }
  .nivel.ouro {
    color: var(--caneta);
    font-weight: 600;
  }
  @media (max-width: 760px) {
    .premios ul li {
      grid-template-columns: 3.5rem 5rem minmax(0, 1fr);
    }
    .premios ul li > :last-child {
      grid-column: 3;
    }
  }

  .contato-grade {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 28rem);
    gap: 2.5rem clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .email {
    display: block;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(1.8rem, 4.2vw, 4rem);
    line-height: 0.95;
    text-decoration: underline;
    text-decoration-thickness: 0.04em;
    text-underline-offset: 0.12em;
    overflow-wrap: anywhere;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.5rem;
  }
  .form {
    display: grid;
    gap: 0.9rem;
  }
  .form-titulo {
    font-size: var(--t-base);
    font-weight: 600;
  }
  .form label {
    display: grid;
    gap: 0.25rem;
    font-size: var(--t-sm);
    color: var(--grafite);
  }
  .form input,
  .form textarea {
    font: inherit;
    font-size: var(--t-base);
    color: var(--tinta);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--tinta);
    border-radius: 0;
    padding: 0.35rem 0;
    resize: vertical;
  }
  .form input:focus-visible,
  .form textarea:focus-visible {
    outline: none;
    border-bottom: 2px solid var(--caneta);
  }
  .form button {
    justify-self: start;
    font: inherit;
    font-weight: 600;
    color: var(--papel);
    background: var(--tinta);
    border: 0;
    padding: 0.7rem 1.4rem;
  }
  .form button:hover {
    background: var(--caneta);
  }
  .enviado {
    color: var(--caneta);
    font-weight: 600;
  }
  @media (max-width: 760px) {
    .contato-grade {
      grid-template-columns: 1fr;
    }
  }
  /* no celular o 04 só encosta de leve na base do carrossel */
  @media (max-width: 760px) {
    .intro {
      --topo-04: -1rem;
    }
  }
</style>

<script>
  import type { TransitionBeforePreparationEvent, TransitionBeforeSwapEvent } from 'astro:transitions/client';

  // Índice cinético: o peso de cada título cresce ao cruzar o centro da tela.
  // No desktop a capa segue o cursor; no toque ela fica no canto e acompanha a rolagem.
  const MIN = 200;
  const MAX = 900;
  const PASSO = 20;

  // capas decodificadas ficam em memória entre navegações
  const capas = new Map<string, Promise<void>>();
  function carregar(src: string) {
    let c = capas.get(src);
    if (!c) {
      const im = new Image();
      im.decoding = 'async';
      im.src = src;
      c = im.decode().catch(() => {});
      capas.set(src, c);
    }
    return c;
  }

  // Transição de página: só o título clicado (ou de onde se volta) recebe nome.
  const idDe = (u: URL) => u.pathname.match(/^(?:\/en)?\/projetos\/([^/]+)\/$/)?.[1];
  const nomear = (doc: Document, id?: string) => {
    if (!id) return;
    doc
      .querySelector<HTMLElement>(`.lista .titulo[data-id="${CSS.escape(id)}"]`)
      ?.style.setProperty('view-transition-name', `titulo-${id}`);
  };
  document.addEventListener('astro:before-preparation', (e) =>
    nomear(document, idDe((e as TransitionBeforePreparationEvent).to)),
  );
  document.addEventListener('astro:before-swap', (e) => {
    const ev = e as TransitionBeforeSwapEvent;
    nomear(ev.newDocument, idDe(ev.from));
  });

  let ctrl: AbortController | undefined;

  function iniciar() {
    ctrl?.abort();
    const lista = document.querySelector<HTMLElement>('[data-indice]');
    const previa = document.querySelector<HTMLElement>('[data-previa]');
    const img = document.querySelector<HTMLImageElement>('[data-previa-img]');
    if (!lista || !previa || !img) return;
    ctrl = new AbortController();
    const { signal } = ctrl;

    const itens = [...lista.querySelectorAll<HTMLElement>('.item')];
    const reduzido = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fino = matchMedia('(hover: hover) and (pointer: fine)');
    const toque = !fino.matches;
    const ultimo = new Array(itens.length).fill(-1);
    let centros: number[] = [];
    let listaTopo = 0;
    let listaFim = 0;
    let naTela = true;
    let ativo: HTMLElement | null = null;
    let hover: HTMLElement | null = null;
    let raf = 0;

    function marcar(el: HTMLElement | null) {
      if (el === ativo) return;
      ativo?.classList.remove('ativo');
      ativo = el;
      if (!el) {
        previa!.classList.remove('visivel');
        return;
      }
      el.classList.add('ativo');
      const src = el.dataset.capa ?? '';
      carregar(src).then(() => {
        if (ativo !== el) return;
        img!.src = src;
        previa!.classList.add('visivel');
      });
    }

    // posições ficam em cache; nada é medido durante a rolagem
    function medir() {
      const y = scrollY;
      centros = itens.map((i) => {
        const r = i.getBoundingClientRect();
        return r.top + y + r.height / 2;
      });
      const lr = lista!.getBoundingClientRect();
      listaTopo = lr.top + y;
      listaFim = lr.bottom + y;
    }

    function quadro() {
      raf = 0;
      const vh = innerHeight;
      const centro = scrollY + vh * 0.5;
      let melhor = -1;
      let melhorD = Infinity;
      for (let j = 0; j < itens.length; j++) {
        const d = Math.abs(centros[j] - centro);
        if (d < melhorD) {
          melhorD = d;
          melhor = j;
        }
        if (reduzido) continue;
        const t = Math.max(0, 1 - d / (vh * 0.42));
        const peso = Math.round((MIN + (MAX - MIN) * t * t * (3 - 2 * t)) / PASSO) * PASSO;
        if (peso !== ultimo[j]) {
          ultimo[j] = peso;
          itens[j].style.setProperty('--peso', String(peso));
        }
      }
      if (toque) marcar(centro > listaTopo && centro < listaFim ? itens[melhor] : null);
    }

    const agendar = () => {
      if (!raf && naTela) raf = requestAnimationFrame(quadro);
    };
    const io = new IntersectionObserver(
      ([e]) => {
        naTela = e.isIntersecting;
        // salto longo (menu Sobre/Contato): sem quadro novo, a capa ficaria presa no canto
        if (!naTela && toque) marcar(null);
        agendar();
      },
      { rootMargin: '50% 0px' },
    );
    io.observe(lista);

    // prévia que segue o cursor, independente da taxa de quadros
    let mx = 0,
      my = 0,
      px = 0,
      py = 0,
      seguindo = 0,
      ultimoT = 0;
    function seguir(agora: number) {
      const dt = ultimoT ? Math.min(agora - ultimoT, 64) : 16.7;
      ultimoT = agora;
      const k = reduzido ? 1 : 1 - Math.pow(1 - 0.18, dt / 16.7);
      px += (mx - px) * k;
      py += (my - py) * k;
      previa!.style.transform = `translate3d(${px}px, ${py}px, 0)`;
      if (Math.abs(mx - px) + Math.abs(my - py) > 0.5) seguindo = requestAnimationFrame(seguir);
      else {
        seguindo = 0;
        ultimoT = 0;
      }
    }
    const mover = (e: PointerEvent) => {
      if (e.pointerType !== 'mouse') return;
      mx = e.clientX;
      my = e.clientY;
      if (!hover) {
        px = mx;
        py = my;
      }
      if (!seguindo) seguindo = requestAnimationFrame(seguir);
    };
    const entrar = (e: PointerEvent) => {
      if (e.pointerType !== 'mouse') return;
      const item = (e.target as HTMLElement).closest<HTMLElement>('.item');
      if (!item) return;
      hover = item;
      marcar(item);
    };
    const focar = (e: FocusEvent) => {
      const item = (e.target as HTMLElement).closest<HTMLElement>('.item');
      if (!item) return;
      const r = item.querySelector('.titulo')!.getBoundingClientRect();
      mx = px = Math.min(r.right, innerWidth * 0.6);
      my = py = r.top + r.height / 2;
      previa!.style.transform = `translate3d(${px}px, ${py}px, 0)`;
      hover = item;
      marcar(item);
    };
    const sair = () => {
      hover = null;
      marcar(null);
    };

    addEventListener('scroll', agendar, { passive: true, signal });
    addEventListener(
      'resize',
      () => {
        medir();
        agendar();
      },
      { signal },
    );
    fino.addEventListener('change', iniciar, { signal });
    if (!toque) {
      lista.addEventListener('pointermove', mover, { signal });
      lista.addEventListener('pointerover', entrar, { signal });
      lista.addEventListener('pointerleave', sair, { signal });
    }
    lista.addEventListener('focusin', focar, { signal });
    lista.addEventListener('focusout', sair, { signal });

    signal.addEventListener('abort', () => {
      cancelAnimationFrame(raf);
      cancelAnimationFrame(seguindo);
      io.disconnect();
    });

    // abertura: só os títulos visíveis, depois que a fonte carrega
    function abertura() {
      if (reduzido) return;
      try {
        if (sessionStorage.getItem('kb-abertura')) return;
        sessionStorage.setItem('kb-abertura', '1');
      } catch {
        return;
      }
      const vh = innerHeight;
      // o nome abre primeiro, letra por letra; os títulos visíveis vêm logo depois
      const nomeAnims = letras.map((l, i) =>
        l.animate([{ fontWeight: 100, opacity: 0.2 }, {}], {
          duration: 900,
          delay: 35 * i,
          easing: 'cubic-bezier(0.23, 1, 0.32, 1)',
          fill: 'backwards',
        }),
      );
      const anims = itens
        .filter((i) => {
          const r = i.getBoundingClientRect();
          return r.bottom > 0 && r.top < vh;
        })
        .flatMap((item, i) => {
          const o: KeyframeAnimationOptions = {
            duration: 700,
            delay: 300 + 60 * i,
            easing: 'cubic-bezier(0.23, 1, 0.32, 1)',
            fill: 'backwards',
          };
          return [item.animate([{ '--peso': '100' } as Keyframe], o), item.animate([{ opacity: 0.15 }], o)];
        })
        .concat(nomeAnims);
      anims.forEach((a) => a.pause());
      Promise.race([document.fonts.ready, new Promise((r) => setTimeout(r, 500))]).then(() =>
        anims.forEach((a) => a.play()),
      );
    }

    // Nome cinético: no desktop o peso de cada letra segue o cursor, como uma lente
    const nome = document.querySelector<HTMLElement>('[data-nome]');
    const letras = nome ? [...nome.querySelectorAll<HTMLElement>('.letra')] : [];
    if (nome && !reduzido && !toque) {
      let rafNome = 0;
      let cx = 0;
      const pesar = () => {
        rafNome = 0;
        if (nome.getBoundingClientRect().bottom < 0) return;
        const alcance = innerWidth * 0.22;
        for (const l of letras) {
          const r = l.getBoundingClientRect();
          const k = Math.max(0, 1 - Math.abs(r.left + r.width / 2 - cx) / alcance);
          l.style.setProperty('--w', String(Math.round((300 + 600 * k) / 20) * 20));
          l.style.setProperty('--k', k.toFixed(2));
        }
      };
      addEventListener(
        'pointermove',
        (e) => {
          if (e.pointerType !== 'mouse') return;
          cx = e.clientX;
          if (!rafNome) rafNome = requestAnimationFrame(pesar);
        },
        { passive: true, signal },
      );
      document.documentElement.addEventListener('pointerleave', () => letras.forEach((l) => {
        l.style.removeProperty('--w');
        l.style.removeProperty('--k');
      }), {
        signal,
      });
      signal.addEventListener('abort', () => cancelAnimationFrame(rafNome));
    }

    // a onda do nome (telas de toque) só roda enquanto o nome está na tela
    if (nome) {
      const vistoNome = new IntersectionObserver(([e]) => nome.classList.toggle('parado', !e.isIntersecting));
      vistoNome.observe(nome);
      signal.addEventListener('abort', () => vistoNome.disconnect());
    }

    // volta do formulário (FormSubmit redireciona com ?enviado=1)
    if (new URLSearchParams(location.search).has('enviado')) {
      document.querySelector<HTMLElement>('[data-enviado]')?.removeAttribute('hidden');
    }

    medir();
    abertura();
    quadro();
    document.fonts.ready.then(() => {
      if (signal.aborted) return;
      medir();
      agendar();
    });
    const ocioso = (window as any).requestIdleCallback ?? ((f: () => void) => setTimeout(f, 300));
    ocioso(() => itens.forEach((i) => carregar(i.dataset.capa ?? '')));
  }

  document.addEventListener('astro:page-load', iniciar);
  document.addEventListener('astro:before-swap', () => ctrl?.abort());
</script>
