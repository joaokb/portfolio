---
import Base from '../layouts/Base.astro';
import perfil from '../data/perfil.json';
import { ui, rota, textoPerfil, type Lang } from '../i18n';
import { medidas, srcset } from '../imagens';
import Sticker from './Sticker.astro';
import { publicados } from '../projetos';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const tp = textoPerfil(lang);

// texto longo do "Sobre"; enquanto não for escrito, usa a bio da home
const paragrafos = tp.sobre.split(/\n\s*\n/).filter(Boolean);
const en = lang === 'en';

// Perguntas frequentes: respostas diretas, montadas só com dados do perfil e dos cases, para busca e IA citarem.
// Marca de competição ou faculdade não é cliente: só entram cases sem esse contexto.
const clientes = [
  ...new Set(
    (await publicados())
      .filter((p) => !/competi|concurso|tcc|faculdade|clube de cria|estudante/i.test(p.data.context ?? ''))
      .map((p) => p.data.client),
  ),
];
const empresas = perfil.experiencia.map((e) => e.empresa);
const lista = (itens: string[]) => (itens.length > 1 ? `${itens.slice(0, -1).join(', ')} ${en ? 'and' : 'e'} ${itens.at(-1)}` : itens[0] ?? '');
const perguntas = [
  {
    p: en ? `Where is ${perfil.nome} based?` : `Onde ${perfil.nome} atua?`,
    r: en ? `In Presidente Prudente, Brazil. ${tp.status}` : `Em ${perfil.cidade}. ${tp.status}`,
  },
  {
    p: en ? 'What kind of work does he do?' : 'Que tipo de trabalho ele faz?',
    // no meio da frase vai em minúscula, menos siglas como UI
    r: `${lista(perfil.competencias.map(tp.tr).map((c, i) => (i && /^[A-ZÀ-Ý][a-zà-ÿ]/.test(c) ? c[0].toLowerCase() + c.slice(1) : c)))}.`,
  },
  {
    p: en ? 'Where has he worked?' : 'Onde ele já trabalhou?',
    r: en
      ? `${lista(empresas)}. Clients in the portfolio include ${lista(clientes)}.`
      : `${lista(empresas)}. Entre os clientes do portfólio estão ${lista(clientes)}.`,
  },
  {
    p: en ? 'Has he won any awards?' : 'Ele tem prêmios?',
    r: `${lista(perfil.premios.map((x) => `${tp.tr(x.nivel)} ${en ? 'at' : 'no'} ${x.festival} ${x.ano} (${x.projeto})`))}.`,
  },
  {
    p: en ? 'Which tools does he use?' : 'Quais ferramentas ele usa?',
    r: `${perfil.ferramentas}.`,
  },
  {
    p: en ? 'How can I contact him?' : 'Como entrar em contato?',
    r: en ? `By email at ${perfil.email}.` : `Pelo e-mail ${perfil.email}.`,
  },
];
const faq = {
  '@type': 'FAQPage',
  mainEntity: perguntas.map(({ p, r }) => ({ '@type': 'Question', name: p, acceptedAnswer: { '@type': 'Answer', text: r } })),
};
---

<Base
  title={en ? `About ${perfil.nome}, art director in Presidente Prudente, Brazil` : `Sobre ${perfil.nome}, diretor de arte em ${perfil.cidade}`}
  description={en
    ? `${perfil.nome}, art director in Presidente Prudente, Brazil: experience, awards, education, tools and frequently asked questions.`
    : `${perfil.nome}, diretor de arte em ${perfil.cidade}: experiência, prêmios, formação, ferramentas e perguntas frequentes.`}
  schema={[faq]}
>
  <section class="sobre" aria-labelledby="titulo-sobre">
    <h1 id="titulo-sobre" class="rotulo">{t.sobre}</h1>
    <Sticker nome="feito" style="top: clamp(3rem, 9vh, 5.5rem); right: 6%; --giro: 6deg; --largura: clamp(7rem, 12vw, 10rem)" />
    <div class:list={['apresenta', { 'com-foto': perfil.foto }]}>
      {
        perfil.foto && (
          <div class="foto-moldura">
          <Sticker nome="prazo" style="top: -1.2rem; left: -1.2rem; --giro: -9deg; --largura: clamp(8rem, 13vw, 11rem)" />
          <Sticker nome="etiqueta" style="bottom: -1.6rem; right: -0.6rem; --giro: 5deg; --largura: clamp(8.5rem, 14vw, 12rem)" />
          <img
            class="foto"
            src={perfil.foto}
            srcset={srcset(perfil.foto)}
            sizes="(max-width: 760px) min(22rem, 92vw), 26rem"
            width={medidas(perfil.foto).w}
            height={medidas(perfil.foto).h}
            alt={`${t.fotoDe} ${perfil.nome}`}
            fetchpriority="high"
          />
          </div>
        )
      }
      <div class="texto">
        {paragrafos.map((p) => <p>{p}</p>)}
        <p class="status secundario">{tp.status}</p>
      </div>
    </div>

    <div class="colunas">
      <div>
        <h2 class="subrotulo">{t.habilidades}</h2>
        <ul class="barras">
          {
            perfil.habilidades.map((h) => (
              <li>
                <span class="barra-nome">{tp.tr(h.nome)}</span>
                <span class="barra-valor">{h.nivel}%</span>
                <span class="barra" role="meter" aria-valuenow={h.nivel} aria-valuemin="0" aria-valuemax="100" aria-label={tp.tr(h.nome)}>
                  <span style={`--v:${h.nivel / 100}`} />
                </span>
              </li>
            ))
          }
        </ul>

        <h2 class="subrotulo">{t.premios}</h2>
        <ul class="tabela premios">
          {
            perfil.premios.map((p) => (
              <li>
                <span class="ano">{p.ano}</span>
                <span class:list={{ ouro: p.nivel === 'Ouro' }}>
                  {tp.tr(p.nivel)}, {p.festival}
                </span>
                <span class="secundario">{p.slug ? <a href={rota(lang, `/projetos/${p.slug}/`)}>{p.projeto}</a> : p.projeto}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="subrotulo">{t.experiencia}</h2>
        <ul class="tabela">
          {
            perfil.experiencia.map((e) => (
              <li>
                <span class="ano">{e.periodo}</span>
                <span>{e.empresa}</span>
                <span class="secundario">{tp.tr(e.funcao)}</span>
              </li>
            ))
          }
        </ul>

        <h2 class="subrotulo">{t.formacao}</h2>
        <ul class="tabela">
          {
            perfil.formacao.map((f) => (
              <li>
                <span class="ano">{f.periodo}</span>
                <span>{tp.tr(f.curso)}</span>
                <span class="secundario">{f.instituicao}</span>
              </li>
            ))
          }
        </ul>

        <h2 class="subrotulo">{t.cursos}</h2>
        <ul class="tabela">
          {
            perfil.cursos.map((c) => (
              <li>
                <span class="ano">{c.ano}</span>
                <span>{tp.tr(c.curso)}</span>
                <span class="secundario">{c.instituicao}</span>
              </li>
            ))
          }
        </ul>

        <h2 class="subrotulo">{t.ferramentas}</h2>
        <p>{perfil.ferramentas}</p>
        {/* currículo completo, com botão de PDF (página /curriculo, montada destes mesmos dados) */}
        <p class="cv">
          <a href={rota(lang, '/curriculo/')}>{lang === 'en' ? 'Full résumé (PDF)' : 'Currículo completo (PDF)'}</a>
        </p>
        <p class="edc">
          <a href={rota(lang, '/edc/')}>{lang === 'en' ? 'What I carry every day' : 'O que eu carrego todo dia'}</a>
        </p>
      </div>
    </div>

    <section class="faq" aria-labelledby="titulo-faq">
      <h2 id="titulo-faq" class="subrotulo">{en ? 'Frequently asked questions' : 'Perguntas frequentes'}</h2>
      <dl>
        {
          perguntas.map(({ p, r }) => (
            <div>
              <dt>{p}</dt>
              <dd>{r}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <p class="contato">
      <a href={`mailto:${perfil.email}`}>{perfil.email}</a>
    </p>
  </section>
</Base>

<style>
  .sobre {
    position: relative;
    padding: clamp(2.5rem, 8vh, 5rem) var(--margem) clamp(4rem, 12vh, 8rem);
  }
  .rotulo {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(3.4rem, 11vw, 13rem);
    line-height: 0.86;
    text-transform: uppercase;
    margin-bottom: clamp(2rem, 5vh, 3.5rem);
  }
  .apresenta {
    display: grid;
    gap: clamp(1.5rem, 4vw, 4rem);
    max-width: var(--coluna);
    margin-bottom: clamp(3rem, 10vh, 6rem);
  }
  .apresenta.com-foto {
    grid-template-columns: minmax(0, 26rem) minmax(0, var(--coluna));
    max-width: none;
    align-items: start;
  }
  .foto-moldura {
    position: relative;
  }
  .foto {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(1);
    background: var(--papel-fundo);
  }
  .texto {
    font-size: var(--t-md);
    line-height: 1.45;
    text-wrap: pretty;
  }
  .texto p + p {
    margin-top: 1em;
  }
  .status {
    font-size: var(--t-base);
  }
  .subrotulo {
    font-size: var(--t-base);
    font-weight: 600;
    margin: 0 0 0.6rem;
  }
  .subrotulo:not(:first-child) {
    margin-top: 2.5rem;
  }
  .colunas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 5rem);
  }
  .tabela li {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) minmax(0, 1fr);
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--linha);
  }
  .ouro {
    color: var(--caneta);
    font-weight: 600;
  }
  .ano {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* Habilidades: barra fina de caneta sobre a linha */
  .barras {
    display: grid;
    gap: 1rem;
  }
  .barras li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.35rem 1rem;
  }
  .barra-valor {
    font-variant-numeric: tabular-nums;
    color: var(--grafite);
  }
  .barra {
    grid-column: 1 / -1;
    height: 3px;
    background: var(--linha);
  }
  .barra span {
    display: block;
    height: 100%;
    background: var(--caneta);
    transform-origin: left;
    transform: scaleX(var(--v));
  }

  .cv {
    margin-top: 2rem;
  }
  /* Tablet: duas colunas de tabela de três campos não cabem; tudo vira uma coluna larga */
  @media (max-width: 1100px) {
    .colunas {
      grid-template-columns: 1fr;
      max-width: 48rem;
    }
    .barras {
      max-width: 32rem;
    }
  }
  .faq {
    margin-top: clamp(3rem, 10vh, 6rem);
    max-width: 48rem;
  }
  .faq dl > div {
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--linha);
  }
  .faq dt {
    font-weight: 600;
  }
  .faq dd {
    margin: 0.3rem 0 0;
    color: var(--grafite);
    line-height: 1.45;
    text-wrap: pretty;
  }
  .contato {
    margin-top: clamp(3rem, 10vh, 6rem);
    font-size: var(--t-md);
  }
  @media (max-width: 760px) {
    .apresenta.com-foto,
    .colunas {
      grid-template-columns: 1fr;
    }
    .foto {
      max-width: 22rem;
    }
    .tabela li {
      grid-template-columns: 4.75rem minmax(0, 1fr);
      row-gap: 0.15rem;
    }
    .tabela li > :last-child {
      grid-column: 2;
    }
  }
</style>
