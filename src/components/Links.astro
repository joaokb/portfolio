---
import Base from '../layouts/Base.astro';
import perfil from '../data/perfil.json';
import links from '../data/links.json';
import { existsSync } from 'node:fs';
import { rota, textoPerfil, type Lang } from '../i18n';
import { publicados, dadosEn } from '../projetos';
import { srcset } from '../imagens';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tp = textoPerfil(lang);
const en = lang === 'en';

// mesma miniatura leve usada na home (vale para .webp e para a foto em .jpg)
const capa = (src: string) => {
  const mini = src.replace(/\.(webp|jpe?g|png)$/i, '.min.webp');
  return mini !== src && existsSync(`public${decodeURI(mini)}`) ? mini : src;
};
const ativos = links.links.filter((l) => l.ativo && l.id && l.url);
const trabalhos = (await publicados()).slice(0, 6).map((p) => ({ id: p.id, data: en ? dadosEn(p.data) : p.data }));
// todo clique passa por /ir/<id>, que conta e redireciona (worker/index.js)
const ir = (id: string) => `/ir/${encodeURIComponent(id)}`;
---

<Base title={`${perfil.nome}, links`} description={tp.bio}>
  <section class="links">
    <header class="perfil">
      {perfil.foto && <img class="foto" src={capa(perfil.foto)} srcset={srcset(perfil.foto)} sizes="96px" alt="" width="96" height="96" fetchpriority="high" />}
      <div>
        <h1 class="nome">{perfil.nome}</h1>
        <p class="cargo">{tp.cargo}</p>
      </div>
    </header>
    <p class="status"><span class="ponto" aria-hidden="true"></span>{tp.status}</p>

    <ul class="botoes">
      {
        ativos.map((l) => (
          <li>
            <a href={ir(l.id)}>{en ? l.titulo_en || l.titulo : l.titulo}</a>
          </li>
        ))
      }
    </ul>

    <h2 class="rotulo">{en ? 'Selected work' : 'Trabalhos'}</h2>
    <ul class="grade">
      {
        trabalhos.map((p, i) => (
          <li>
            <a href={ir(`${en ? 'en-' : ''}trabalho-${p.id}`)}>
              {/* a primeira linha da grade costuma aparecer na primeira tela: carrega logo */}
              <img
                src={capa(p.data.preview || p.data.cover)}
                srcset={srcset(p.data.preview || p.data.cover)}
                sizes="(max-width: 560px) 31vw, 180px"
                width="180"
                height="225"
                alt=""
                loading={i < 3 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <span>{p.data.title}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <h2 class="rotulo">{en ? 'About' : 'Sobre'}</h2>
    <p class="bio">{tp.bio}</p>
    <p class="mais"><a href={rota(lang, '/sobre/')}>{en ? 'More about me' : 'Mais sobre mim'}</a></p>
  </section>
</Base>

<style>
  .links {
    max-width: 34rem;
    margin: 0 auto;
    padding: clamp(1.5rem, 5vh, 3rem) var(--margem) clamp(3rem, 10vh, 5rem);
  }
  .perfil {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .foto {
    width: 6rem;
    height: 6rem;
    object-fit: cover;
    filter: grayscale(1);
    flex: none;
  }
  .nome {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(2.6rem, 11vw, 3.6rem);
    line-height: 0.88;
    text-transform: uppercase;
  }
  .cargo {
    margin-top: 0.35rem;
    font-weight: 600;
  }
  .status {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    margin-top: 1.1rem;
    color: var(--grafite);
  }
  .ponto {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--caneta);
    flex: none;
    transform: translateY(-0.05em);
  }

  .botoes {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }
  .botoes a {
    display: block;
    padding: 1rem 1.1rem;
    border: 1px solid var(--tinta);
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.6rem;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .botoes a:hover,
  .botoes a:focus-visible {
    background: var(--caneta);
    border-color: var(--caneta);
    color: var(--papel);
  }

  .rotulo {
    margin: 2.5rem 0 0.9rem;
    font-family: var(--display);
    font-weight: 800;
    font-size: 2rem;
    line-height: 0.9;
    text-transform: uppercase;
  }
  .grade {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
  }
  .grade a {
    display: grid;
    gap: 0.35rem;
    text-decoration: none;
    font-size: var(--t-sm);
    line-height: 1.25;
  }
  .grade img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 0.3s;
    background: var(--papel-fundo);
  }
  .grade a:hover img,
  .grade a:focus-visible img {
    filter: none;
  }
  .bio {
    font-size: var(--t-md);
    line-height: 1.4;
    text-wrap: pretty;
  }
  .mais {
    margin-top: 1rem;
    font-weight: 600;
  }
</style>

<script>
  // avisa uma visita por carregamento; o worker ignora robôs
  document.addEventListener('astro:page-load', () => {
    if (/^\/(en\/)?links\/?$/.test(location.pathname)) navigator.sendBeacon?.('/ir/_visita');
  });
</script>
