---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/big-shoulders-display';
import '@fontsource-variable/schibsted-grotesk';
import '../styles/global.css';
import perfil from '../data/perfil.json';
import destaques from '../data/destaques.json';
import links from '../data/links.json';
import Rodape from '../components/Rodape.astro';
import { ui, rota, langDe, outraRota, textoPerfil } from '../i18n';
import fonteDisplay from '@fontsource-variable/big-shoulders-display/files/big-shoulders-display-latin-wght-normal.woff2?url';
import fonteTexto from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** dados estruturados extras da página (CreativeWork do case, FAQPage do Sobre) */
  schema?: Record<string, unknown>[];
}
// cor de destaque escolhida em perfil.json; todas passam de 4.5:1 de contraste sobre o papel
// (lista em src/data/destaques.json, usada também por scripts/gerar-og.mjs)
const destaque = (destaques as Record<string, string>)[perfil.destaque] ?? destaques.caneta;
const lang = langDe(Astro.url);
const t = ui[lang];
const tp = textoPerfil(lang);
const en = lang === 'en';
// título e descrição padrão (home) com cidade: é o que a busca local lê primeiro. Descrição até ~155 caracteres.
const {
  // "designer" junto: é o termo mais buscado por quem contrata na região; diretor de arte vem na frente (é a vaga buscada)
  title = en
    ? `${perfil.nome}, art director and designer in Presidente Prudente, Brazil`
    : `${perfil.nome}, diretor de arte e designer em ${perfil.cidade}`,
  description = en
    ? `${perfil.nome}, art director and designer in Presidente Prudente, Brazil. 7 years in advertising: campaigns, visual identity and graphic design.`
    : `${perfil.nome}, diretor de arte e designer em ${perfil.cidade}. 7 anos em publicidade, com campanhas, identidade visual e design gráfico.`,
  image,
  schema = [],
} = Astro.props;
const site = Astro.site!;
const url = new URL(Astro.url.pathname, site);
// versões nas duas línguas, para o hreflang de cada página apontar para si mesma e para a outra
const outra = new URL(outraRota(Astro.url), site);
const urlPt = en ? outra : url;
const urlEn = en ? url : outra;
// ?v= muda quando a og.png é refeita (scripts/gerar-og.mjs), para WhatsApp e LinkedIn buscarem a nova
const imagemOg = image ?? new URL('/og.png?v=2', site).href;
const whatsapp = links.links.find((l) => l.id === 'whatsapp')?.url.match(/wa\.me\/(\d+)/)?.[1];
const idPessoa = new URL('/#joao', site).href;
const pessoa = {
  '@type': 'Person',
  '@id': idPessoa,
  name: perfil.nome,
  url: site.href,
  image: new URL(perfil.foto, site).href,
  jobTitle: [tp.cargo, en ? 'Graphic designer' : 'Designer gráfico'],
  description: tp.bio,
  email: `mailto:${perfil.email}`,
  ...(whatsapp && { telephone: `+${whatsapp}` }),
  address: { '@type': 'PostalAddress', addressLocality: 'Presidente Prudente', addressRegion: 'SP', addressCountry: 'BR' },
  homeLocation: { '@type': 'City', name: 'Presidente Prudente, SP' },
  knowsAbout: [en ? 'Graphic design' : 'Design gráfico', ...perfil.competencias.map(tp.tr)],
  award: perfil.premios.map((p) => `${tp.tr(p.nivel)}, ${p.festival} ${p.ano} (${p.projeto})`),
  alumniOf: [...new Set(perfil.formacao.map((f) => f.instituicao))].map((name) => ({ '@type': 'CollegeOrUniversity', name })),
  // só perfis externos; o próprio site já é a url
  sameAs: perfil.links.map((l) => l.url).filter((u) => !u.startsWith(site.origin)),
};
const dados = {
  '@context': 'https://schema.org',
  '@graph': [
    pessoa,
    { '@type': 'WebSite', '@id': new URL('/#site', site).href, url: site.href, name: perfil.nome, inLanguage: ['pt-BR', 'en'], publisher: { '@id': idPessoa } },
    ...schema,
  ],
};
---

<!doctype html>
<html lang={lang === 'en' ? 'en' : 'pt-BR'} style={`--caneta:${destaque}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="preload" href={fonteDisplay} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fonteTexto} as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content={image ? 'article' : 'profile'} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'pt_BR'} />
    <link rel="alternate" hreflang="pt-BR" href={urlPt} />
    <link rel="alternate" hreflang="en" href={urlEn} />
    <link rel="alternate" hreflang="x-default" href={urlPt} />
    <meta property="og:image" content={imagemOg} />
    {
      !image && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={`${perfil.nome}, ${tp.cargo.toLowerCase()}`} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(dados)} />
    <meta name="theme-color" content="#e4e5e0" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="pular" href="#conteudo">{t.pular}</a>
    <header class="topo">
      <a class="assinatura" href={rota(lang, '/')}>{perfil.nome}</a>
      <nav aria-label={lang === 'en' ? 'Main' : 'Principal'}>
        <a href={rota(lang, '/#trabalhos')}>{t.trabalhos}</a>
        <a href={rota(lang, '/sobre/')}>{t.sobre}</a>
        <a href={rota(lang, '/#contato')}>{t.contato}</a>
        <a class="idioma" href={outraRota(Astro.url)} hreflang={lang === 'en' ? 'pt-BR' : 'en'} aria-label={t.trocarRotulo}>{t.trocar}</a>
      </nav>
    </header>
    <main id="conteudo">
      <slot />
    </main>
    <Rodape lang={lang} />
    <script>
      // ao chegar por transição, o título já vem em peso final (sem reanimar)
      document.addEventListener('astro:after-swap', () => {
        document.documentElement.dataset.chegada = 'vt';
      });

      // Board de prêmio sem página de projeto: abre por cima da página, com a legenda; clique ou Esc fecha.
      // Sem JavaScript (ou com Ctrl/Cmd), o link abre a imagem direto.
      document.addEventListener('click', (e) => {
        const a = (e.target as Element).closest?.<HTMLAnchorElement>('a[data-board]');
        if (!a || e.ctrlKey || e.metaKey || e.shiftKey) return;
        e.preventDefault();
        let dlg = document.querySelector<HTMLDialogElement>('dialog.board');
        if (!dlg) {
          dlg = document.createElement('dialog');
          dlg.className = 'board';
          dlg.innerHTML = '<img alt=""><p></p>';
          dlg.addEventListener('click', () => dlg!.close());
          document.body.append(dlg);
        }
        const legenda = a.dataset.legenda ?? '';
        dlg.querySelector('img')!.src = a.href;
        dlg.querySelector('img')!.alt = legenda;
        dlg.querySelector('p')!.textContent = legenda;
        dlg.showModal();
        // fase de captura: roda antes do roteador de transições, que trataria o link como navegação
      }, true);

      // Sem menu do botão direito (exceto em campos de formulário, para colar).
      // shortcut: só dificulta salvar imagens; quem quiser ainda baixa pelo navegador
      document.addEventListener('contextmenu', (e) => {
        if (!(e.target as Element).closest?.('input, textarea')) e.preventDefault();
      });

      // Seleção de texto como marca-texto: um retângulo por linha, varrendo da esquerda
      document.documentElement.classList.add('js-marca');
      const marca = document.createElement('div');
      marca.className = 'marca-texto';
      let ultima = '';
      const limpar = () => {
        marca.replaceChildren();
        ultima = '';
      };
      document.addEventListener('selectionchange', () => {
        const sel = getSelection();
        if (!marca.isConnected) document.body.append(marca);
        if (!sel || sel.isCollapsed || !sel.rangeCount || document.activeElement?.matches('input, textarea')) return limpar();
        const rects = [...sel.getRangeAt(0).getClientRects()].filter((r) => r.width > 1 && r.height > 1);
        const chave = rects.map((r) => `${r.left | 0},${r.top | 0},${r.width | 0}`).join(';');
        if (chave === ultima) return;
        // anima só quando a seleção nasce (duplo clique, teclado); arrastando, acompanha o cursor sem reiniciar
        const nova = !ultima;
        ultima = chave;
        marca.replaceChildren(
          ...rects.map((r, i) => {
            const s = document.createElement('span');
            s.style.cssText = `left:${r.left + scrollX}px;top:${r.top + scrollY}px;width:${r.width}px;height:${r.height}px`;
            s.style.animation = nova ? '' : 'none';
            s.style.animationDelay = `${i * 50}ms`;
            return s;
          }),
        );
      });
      addEventListener('resize', limpar);
      document.addEventListener('astro:after-swap', limpar);
    </script>
  </body>
</html>
